# Database (Supabase / Prisma)
DATABASE_URL=
DIRECT_URL=

# Auth (next-auth@beta)
AUTH_SECRET=

# Email (Resend)
AUTH_RESEND_KEY=
EMAIL_FROM=noreply@deltechmun.in

# App
# The origin used in outbound links (status pages, payment links, check-in QR,
# quiz join URLs). Leave BLANK on PR previews: src/lib/app-url.ts then falls
# back to NEXT_PUBLIC_VERCEL_URL so a preview's emails link back to itself.
#   production  https://deltechmun.in
#   staging     https://test.deltechmun.in
NEXT_PUBLIC_APP_URL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Admin
ADMIN_EMAIL=

# Cron (Vercel Cron; must match the Authorization: Bearer <value> header).
# Leave UNSET on staging: the cron routes fail closed at 401, which is what we
# want, since staging must not send reminder emails or re-run the sheet ingest.
CRON_SECRET=

# Google Form intake (shared secret checked by /api/webhooks/gform;
# same value goes into docs/apps-script/gform-webhook.gs CONFIG.secret)
GFORM_SHARED_SECRET=

# Google Sheet mirror (secret POSTed to the Apps Script web app;
# same value goes into docs/apps-script/sheet-mirror.gs SECRET).
# Leave UNSET on staging so it cannot write to the public sheet.
SHEET_SYNC_SECRET=

# AI (Groq — free tier, no billing needed — get key at console.groq.com)
GROQ_API_KEY=
# Optional: override model (default: llama-3.3-70b-versatile)
GROQ_MODEL=
