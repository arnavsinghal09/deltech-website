// Phase 1 models. URLs live in prisma.config.ts (Prisma v7 — no url in datasource).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---- Auth (NextAuth / @auth/prisma-adapter) ----

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  role          Role      @default(AUTHOR)
  passwordHash  String?
  emailVerified DateTime?
  disabledAt    DateTime?
  createdAt     DateTime  @default(now())
  accounts      Account[]
  sessions      Session[]
  posts         Post[]
}

enum Role {
  ADMIN
  MAINTAINER
  AUTHOR
  REGISTERER
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---- Conference config (all editable from dashboard) ----

model StringOverride {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model Committee {
  id               String        @id @default(cuid())
  name             String
  slug             String        @unique
  agenda           String?
  aliases          String[]      @default([])
  type             CommitteeType @default(STANDARD)
  doubleDelegation Boolean       @default(false)
  ebMembers        Json?
  isActive         Boolean       @default(true)
  sortOrder        Int           @default(0)
  portfolioTagLabel String?
  matrixBrief      String?
  portfolios       Portfolio[]
}

enum CommitteeType {
  STANDARD
  CRISIS
  PRESS
}

model Portfolio {
  id          String          @id @default(cuid())
  committeeId String
  committee   Committee       @relation(fields: [committeeId], references: [id])
  name        String
  tag         String?
  priority    Int             @default(0)
  status      PortfolioStatus @default(AVAILABLE)
  allotment   Allotment?

  @@unique([committeeId, name])
}

enum PortfolioStatus {
  AVAILABLE
  ON_HOLD
  ALLOTTED
  BLOCKED
}

model Fee {
  id            String  @id @default(cuid())
  label         String
  committeeType String
  isDtu         Boolean @default(false)
  amountInr     Int
}

// ---- Registrations ----

model Delegate {
  id                 String     @id @default(cuid())
  publicToken        String     @unique @default(uuid(4))
  fullName           String
  email              String     @unique
  whatsapp           String
  altPhone           String?
  institution        String
  isDtu              Boolean    @default(false)
  munExperience      String?
  source             Source     @default(SELF)
  sourceNote         String?
  pref1CommitteeId   String?
  pref1Portfolio     String?
  pref2CommitteeId   String?
  pref2Portfolio     String?
  pref3CommitteeId   String?
  pref3Portfolio     String?
  needsAccommodation Boolean    @default(false)
  outsideNcr         Boolean    @default(false)
  reference          String?
  status             AppStatus  @default(REGISTERED)
  coDelegate         CoDelegate?
  allotment          Allotment?
  payment            Payment?
  emailLogs          EmailLog[]
  createdAt          DateTime   @default(now())
  checkedInAt        DateTime?
  checkedInBy        String?
}

enum Source {
  SELF
  CROSS_DEL
  SPONSORED
  INTERNAL
  MANUAL
}

enum AppStatus {
  REGISTERED
  ALLOTTED
  PAYMENT_SENT
  CONFIRMED
  CANCELLED
  WAITLISTED
}

model CoDelegate {
  id            String   @id @default(cuid())
  delegateId    String   @unique
  delegate      Delegate @relation(fields: [delegateId], references: [id])
  fullName      String
  email         String
  phone         String
  institution   String?
  munExperience String?
}

model Allotment {
  id          String    @id @default(cuid())
  delegateId  String    @unique
  delegate    Delegate  @relation(fields: [delegateId], references: [id])
  committeeId String
  portfolioId String    @unique
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id])
  allottedAt  DateTime  @default(now())
  allottedBy  String
  emailSentAt DateTime?
}

// ---- Payments ----

model Payment {
  id                String    @id @default(cuid())
  delegateId        String    @unique
  delegate          Delegate  @relation(fields: [delegateId], references: [id])
  provider          String
  amountInr         Int
  status            PayStatus @default(PENDING)
  razorpayOrderId   String?
  razorpayPaymentId String?
  paymentLink       String?
  method            String?
  confirmedAt       DateTime?
  createdAt         DateTime  @default(now())
}

model ImportPreset {
  id        String   @id @default(cuid())
  name      String   @unique
  partner   String?
  mapping   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EmailLog {
  id         String    @id @default(cuid())
  delegateId String?
  template   String
  toEmail    String
  status     String    @default("SENT")
  error      String?
  sentAt     DateTime  @default(now())
  delegate   Delegate? @relation(fields: [delegateId], references: [id])
}

enum PayStatus {
  PENDING
  SENT
  PAID
  FAILED
  COMPED
  OFFLINE
}

// ---- Society recruitment (GD/PI) ----

model Applicant {
  id        String          @id @default(cuid())
  fullName  String
  email     String          @unique
  phone     String?
  year      String?
  branch    String?
  answers   Json?
  status    ApplicantStatus @default(APPLIED)
  gdSlotId  String?
  gdSlot    InterviewSlot?  @relation("gd", fields: [gdSlotId], references: [id])
  gdScore   Int?
  gdVerdict Verdict?
  piSlotId  String?
  piSlot    InterviewSlot?  @relation("pi", fields: [piSlotId], references: [id])
  piScore   Int?
  piVerdict Verdict?
  createdAt DateTime        @default(now())
}

// ponytail: recruitment is now offline single-page scoring — InterviewSlot,
// the gd/piSlot columns on Applicant, and the *_SCHEDULED ApplicantStatus
// values are unused by the app. Left in place to avoid a destructive migration
// for no gain; drop them together in the next real migration.
model InterviewSlot {
  id           String         @id @default(cuid())
  round        InterviewRound
  startsAt     DateTime
  venue        String?
  capacity     Int            @default(8)
  panel        Json?
  gdApplicants Applicant[]    @relation("gd")
  piApplicants Applicant[]    @relation("pi")
}

enum InterviewRound {
  GD
  PI
}

enum Verdict {
  SHORTLIST
  REJECT
  SELECT
}

enum ApplicantStatus {
  APPLIED
  GD_SCHEDULED
  GD_DONE
  PI_SCHEDULED
  PI_DONE
  SELECTED
  REJECTED
}

// ---- Team ----

model Member {
  id          String  @id @default(cuid())
  name        String
  designation String
  order       Int     @default(0)
  imageUrl    String?
  socials     Json?
  isActive    Boolean @default(true)
}

// ---- Audit ----

model AuditLog {
  id         String   @id @default(cuid())
  actorEmail String
  action     String
  entity     String
  entityId   String?
  meta       Json?
  at         DateTime @default(now())

  @@index([at])
}

// ---- Intake quarantine ----

model QuarantinedRow {
  id         String    @id @default(cuid())
  source     String
  presetName String?
  raw        Json
  errors     String[]
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
}

// ---- Blog ----

model Post {
  id          String     @id @default(cuid())
  authorId    String
  author      User       @relation(fields: [authorId], references: [id])
  title       String
  subtitle    String?
  slug        String     @unique
  coverImage  String?
  contentJson Json
  status      PostStatus @default(DRAFT)
  readMin     Int?
  tags        String[]
  reviewNote  String?
  submittedAt DateTime?
  publishedAt DateTime?
}

enum PostStatus {
  DRAFT
  PENDING
  CHANGES_REQUESTED
  PUBLISHED
  REJECTED
}

// ---- Quiz ----

model Presentation {
  id        String     @id @default(cuid())
  ownerId   String
  title     String
  theme     Json?
  mode      QuizMode   @default(POLL)
  slides    Slide[]
  createdAt DateTime   @default(now())
}

enum QuizMode {
  POLL
  QUIZ
}

model Slide {
  id             String       @id @default(cuid())
  presentationId String
  presentation   Presentation @relation(fields: [presentationId], references: [id])
  order          Int
  type           SlideType
  prompt         String
  config         Json
}

enum SlideType {
  MCQ
  WORDCLOUD
  SCALE
  OPEN_TEXT
  CONTENT
}

model QuizSession {
  id             String    @id @default(cuid())
  presentationId String
  roomCode       String    @unique
  status         String    @default("lobby")
  currentSlideId String?
  startedAt      DateTime?
  endedAt        DateTime?
}

model Response {
  id        String   @id @default(cuid())
  sessionId String
  slideId   String
  nickname  String?
  answer    Json
  points    Int      @default(0)
  createdAt DateTime @default(now())

  @@index([sessionId, slideId])
  // The application-level "already submitted" check is a read-then-write, so
  // two taps ~50ms apart both passed it and scored twice. This is the real
  // guard. ponytail: Postgres treats NULLs as distinct, so it covers QUIZ mode
  // (nicknamed, where points matter) and not anonymous POLL votes; add
  // NULLS NOT DISTINCT if anonymous ballot-stuffing ever matters.
  @@unique([sessionId, slideId, nickname])
}
